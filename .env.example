# Copy to .env for the containers. .env is ignored by git, so real values never get committed.

# The host port of the database container, use 5433 when a local PostgreSQL already has 5432
POSTGRES_PORT=5432

# At least 32 random characters
Jwt__Key=
Admin__Email=admin@audiophile.local
# At least 8 characters
Admin__Password=

# Off only while running the checkout load test, see docs/performance.md
# RATE_LIMITING=false

# Optional, card payments need them, cash on delivery works without
# Fawaterak__ApiKey=
# Fawaterak__VendorKey=
# Fawaterak__CardPaymentMethodId=
# Fawaterak__PublicBaseUrl=
