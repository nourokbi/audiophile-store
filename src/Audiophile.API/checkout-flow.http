### The whole checkout journey from sign up to a confirmed order, send the requests from top to bottom
### Before starting run the API, set the Fawaterak staging secrets, and run ngrok so the real webhook can reach you

@base = http://localhost:5040
# XX59 Headphones, seeded by the first migration
@productId = 4ae5911a-421b-4565-b75f-53809c3da182
# Response values are written inside each request because Visual Studio evaluates top level variables before every request


############################## Sign up with a new email on every run and get an access token
# @name signUp
POST {{base}}/auth/register
Content-Type: application/json

{ "name": "Mona Hassan", "email": "buyer.{{$timestamp}}@example.com", "password": "password-123" }


############################## Save a shipping address that the order will copy
# @name address
POST {{base}}/addresses
Authorization: Bearer {{signUp.response.body.$.accessToken}}
Content-Type: application/json

{ "fullAddressName": "Mona Hassan", "street": "12 Tahrir Street", "city": "Cairo", "country": "Egypt", "phone": "+201000000000", "postalCode": null }


############################## Add to cart and get the cart with its totals
POST {{base}}/cart/items
Authorization: Bearer {{signUp.response.body.$.accessToken}}
Content-Type: application/json

{ "productId": "{{productId}}", "quantity": 1 }


############################## Check the cart before paying
GET {{base}}/cart
Authorization: Bearer {{signUp.response.body.$.accessToken}}


############################## Place a card order, the response carries payment.checkoutUrl and the cart is now empty
# @name order
POST {{base}}/orders
Authorization: Bearer {{signUp.response.body.$.accessToken}}
Content-Type: application/json
Idempotency-Key: card-{{$timestamp}}

{ "addressId": "{{address.response.body.$.id}}", "paymentMethod": "Card" }


############################## The same Idempotency-Key again returns 200 with the same order and no second invoice
POST {{base}}/orders
Authorization: Bearer {{signUp.response.body.$.accessToken}}
Content-Type: application/json
Idempotency-Key: {{order.request.headers.Idempotency-Key}}

{ "addressId": "{{address.response.body.$.id}}", "paymentMethod": "Card" }


############################## Pay by opening payment.checkoutUrl in the browser with the staging test card 5123450000000008, expiry 12/26, CVV 100


############################## Is it paid, with ngrok running the webhook has already confirmed it
GET {{base}}/orders/{{order.response.body.$.id}}
Authorization: Bearer {{signUp.response.body.$.accessToken}}


############################## A forged webhook with a wrong hashKey is refused with 401 and changes nothing
POST {{base}}/payments/fawaterak/webhook_json
Content-Type: application/json

{
  "invoice_id": 123456,
  "invoice_key": "fake",
  "invoice_status": "paid",
  "payment_method": "Card",
  "pay_load": "{\"order_id\":\"{{order.response.body.$.id}}\"}",
  "hashKey": "not-a-real-signature"
}


############################## Log in as the admin to ask Fawaterak directly when the webhook never arrived
# @name admin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@audiophile.local", "password": "<Admin:Password from user-secrets>" }

### Sync the order with Fawaterak, it becomes Confirmed once Fawaterak says it is paid
POST {{base}}/orders/{{order.response.body.$.id}}/payment/sync
Authorization: Bearer {{admin.response.body.$.accessToken}}

### Every message Fawaterak sent about this order
GET {{base}}/orders/{{order.response.body.$.id}}/payment/events
Authorization: Bearer {{admin.response.body.$.accessToken}}

### A customer cannot use the support tools and gets 403
POST {{base}}/orders/{{order.response.body.$.id}}/payment/sync
Authorization: Bearer {{signUp.response.body.$.accessToken}}


############################## Cash on delivery is confirmed at once without Fawaterak, add something to the cart first
# @name codOrder
POST {{base}}/orders
Authorization: Bearer {{signUp.response.body.$.accessToken}}
Content-Type: application/json
Idempotency-Key: cod-{{$timestamp}}

{ "addressId": "{{address.response.body.$.id}}", "paymentMethod": "CashOnDelivery" }


############################## Cancel the cash order, its stock goes back and the status becomes Cancelled
POST {{base}}/orders/{{codOrder.response.body.$.id}}/cancel
Authorization: Bearer {{signUp.response.body.$.accessToken}}

### Cancelling it again is refused with 409
POST {{base}}/orders/{{codOrder.response.body.$.id}}/cancel
Authorization: Bearer {{signUp.response.body.$.accessToken}}

### Cancelling the paid card order is refused with 409 because the refund is done by support
POST {{base}}/orders/{{order.response.body.$.id}}/cancel
Authorization: Bearer {{signUp.response.body.$.accessToken}}


############################## My orders
GET {{base}}/orders
Authorization: Bearer {{signUp.response.body.$.accessToken}}
