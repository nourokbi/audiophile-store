{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//ConnectionStrings": "Set ConnectionStrings__Default in the environment (Neon in production). Never put a real password here.",
  "ConnectionStrings": {
    "Default": ""
  },

  "Database": {
    "MigrateOnStartup": false
  },

  "//Jwt": "Jwt__Key is a secret: user-secrets locally, an environment variable in production.",
  "Jwt": {
    "Issuer": "audiophile-api",
    "Audience": "audiophile-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },

  "//Admin": "Optional. Admin__Email and Admin__Password create the first admin account at startup.",
  "Admin": {
    "Name": "Store Admin"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Fawaterak": {
    "BaseUrl": "https://staging.fawaterk.com/api/v2/",
    "CardPaymentMethodId": 0,
    "PublicBaseUrl": ""
  }
}
