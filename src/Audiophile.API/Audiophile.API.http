### Click Send request above each block, starting with register or login because the others use the token they return
@base = http://localhost:5040
# XX59 Headphones, seeded by the first migration
@productId = 4ae5911a-421b-4565-b75f-53809c3da182
# Response values are written inside each request because Visual Studio evaluates top level variables before every request


############################## Auth

### Register a customer, change the email to register another one
# @name register
POST {{base}}/auth/register
Content-Type: application/json

{ "name": "Mona Hassan", "email": "mona@example.com", "password": "password-123" }

### Log in, for the admin use Admin:Email and Admin:Password from dotnet user-secrets list
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "mona@example.com", "password": "password-123" }

### Who am I
GET {{base}}/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### New token pair from the audiophile_refresh cookie that login set, an old cookie sent again ends every session
POST {{base}}/auth/refresh

### Log out the session in the cookie and delete it
POST {{base}}/auth/logout


############################## Catalogue

### Browse the catalogue, every filter is optional
GET {{base}}/products?category=Headphones&minPrice=1000&page=1&pageSize=12

### One product
GET {{base}}/products/{{productId}}

### The admin products page, hidden ones included, every filter is optional
GET {{base}}/admin/products?availability=Hidden&lowStockOnly=true&sort=StockLowToHigh&q=speaker
Authorization: Bearer {{login.response.body.$.accessToken}}

### Add a product, admin only so log in as the admin first or get 403
POST {{base}}/admin/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "XX99 Mark I Headphones",
  "description": "As the gold standard for headphones, the classic XX99 Mark I offers detailed and accurate audio reproduction.",
  "features": "Lightweight build, detachable cable.",
  "price": 9999,
  "stock": 12,
  "category": "Headphones",
  "imageUrl": null,
  "inTheBox": { "Headphone unit": 1, "Replacement earcups": 2, "User manual": 1 }
}


############################## Addresses

### Save an address
# @name address
POST {{base}}/addresses
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "fullAddressName": "Mona Hassan", "street": "12 Tahrir Street", "city": "Cairo", "country": "Egypt", "phone": "+201000000000", "postalCode": null }

### My addresses
GET {{base}}/addresses
Authorization: Bearer {{login.response.body.$.accessToken}}


############################## Cart

### Add to cart
POST {{base}}/cart/items
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "productId": "{{productId}}", "quantity": 1 }

### My cart
GET {{base}}/cart
Authorization: Bearer {{login.response.body.$.accessToken}}


############################## Orders
# Orders come from the cart and a saved address, the card payment journey is in checkout-flow.http

### Cash on delivery is confirmed at once, with a new Idempotency-Key on every send
# @name codOrder
POST {{base}}/orders
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json
Idempotency-Key: cod-{{$timestamp}}

{ "addressId": "{{address.response.body.$.id}}", "paymentMethod": "CashOnDelivery" }

### The same Idempotency-Key again returns 200 with the same order
POST {{base}}/orders
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json
Idempotency-Key: {{codOrder.request.headers.Idempotency-Key}}

{ "addressId": "{{address.response.body.$.id}}", "paymentMethod": "CashOnDelivery" }

### My orders
GET {{base}}/orders
Authorization: Bearer {{login.response.body.$.accessToken}}

### Every customer's orders, admin only, every filter is optional and statusCounts ignores the status filter
GET {{base}}/admin/orders?status=Confirmed&from=2026-10-01&to=2026-10-31&q=mona&page=1&pageSize=10
Authorization: Bearer {{login.response.body.$.accessToken}}

### The overview numbers, admin only, days is 1 to 365
GET {{base}}/admin/orders/stats?days=30
Authorization: Bearer {{login.response.body.$.accessToken}}

### One order with its customer, address and items, admin only
GET {{base}}/admin/orders/{{codOrder.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Move an order one step, only a status in its nextStatuses is accepted, Cancelled returns the stock
PUT {{base}}/admin/orders/{{codOrder.response.body.$.id}}/status
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Processing" }

### Health
GET {{base}}/health
